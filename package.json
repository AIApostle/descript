{
  "name": "descript",
  "private": true,
  "scripts": {
    "start": "npm run start:backend",
    "start:backend": "cd backend && uv run descript-api",
    "start:frontend": "npm --prefix public/app run dev",
    "build": "npm --prefix public/app run build",
    "build:frontend": "npm --prefix public/app run build",
    "build:backend": "cd backend && uv build",
    "build:sdk": "cd sdk && uv build",
    "build:all": "npm run build && npm run build:backend && npm run build:sdk",
    "test": "npm run test:backend && npm run test:sdk && npm run test:frontend",
    "test:backend": "cd backend && uv run pytest -v",
    "test:sdk": "cd sdk && uv run --with-editable ../backend --with aiosqlite pytest -v",
    "test:frontend": "npm --prefix public/app test"
  },
  "dependencies": {
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11"
  }
}
