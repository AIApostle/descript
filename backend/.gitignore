# ==============================================================================
# Descript Backend .gitignore
# ==============================================================================

# Environment files & secrets (DO NOT COMMIT)
.env
.env.*
*.local
!.env.example

# Neon CLI local cache & state
.neon

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Build & packaging artifacts
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing & Linting
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# SQLite fallback databases & private keys
*.db
*.sqlite
*.sqlite3
*.pem
*.key

# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
