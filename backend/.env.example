# ==============================================================================
# Descript Backend Environment Variables Template
# Copy this file to .env or .env.local and fill in the values for your environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=Descript
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Neon PostgreSQL Connection Strings
# ------------------------------------------------------------------------------
# Pooled connection string (recommended for application runtime traffic)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-endpoint-pooler.c-3.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct unpooled connection string (used for schema migrations and DDL in db/)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:your_password@ep-your-endpoint.c-3.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon Branch Information
NEON_BRANCH=production
NEON_BRANCH_ID=br-your-branch-id

# ------------------------------------------------------------------------------
# Neon Managed Auth & JWKS Verification
# ------------------------------------------------------------------------------
# Base URL for Neon Auth service
NEON_AUTH_BASE_URL=https://ep-your-endpoint.neonauth.c-3.eu-west-2.aws.neon.tech/neondb/auth

# JWKS endpoint used to verify tokens issued by Neon Auth
NEON_AUTH_JWKS_URL=https://ep-your-endpoint.neonauth.c-3.eu-west-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# ------------------------------------------------------------------------------
# JWT & Security Configuration
# ------------------------------------------------------------------------------
# Strong 32+ byte random string for signing internal session JWTs
JWT_SECRET=change-this-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# Optional 64-char hex Ed25519 seed for signing Bytecript digital identity cards
# DESCRIPT_ISSUER_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# CORS Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://descript-ffch.onrender.com
