# Neon PostgreSQL Connection String
# Copy to .env and replace with your Neon connection string from the Neon Console.
# Example:
# DATABASE_URL=postgresql://neondb_owner:npg_xxxxx@ep-cool-darkness-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://user:password@ep-your-project.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT signing secret (generate a strong 32+ byte random string for production)
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars

# Optional 64-char hex Ed25519 seed for signing Bytecript digital identity cards
# DESCRIPT_ISSUER_PRIVATE_KEY=

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


